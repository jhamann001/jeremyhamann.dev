{
  "name": "transfer-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:dev": "tsx src/mcp/http-server.ts",
    "mcp:build": "tsup src/mcp/http-server.ts --format cjs --platform node --target node22 --out-dir dist/mcp --clean --external @prisma/client --external prisma",
    "mcp:start": "node dist/mcp/http-server.js",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "demo:reset": "tsx scripts/demo-reset.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/client": "6.19.3",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.0",
    "google-auth-library": "10.7.0",
    "lucide-react": "1.24.0",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "pdf-lib": "1.17.1",
    "pino": "10.3.1",
    "prisma": "6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swr": "2.4.1",
    "zod": "4.4.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@sentry/node": "11.4.0",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.3",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.2",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
