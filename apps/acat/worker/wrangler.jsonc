{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "transfers-demo",
  "main": "src/index.js",
  // The app's built static files, copied out of its image by the deploy (.github/workflows/deploy-acat.yml).
  // A request that matches one is answered by Cloudflare directly, without this Worker or the container, so
  // pages load fast and a sleeping container isn't woken for them; anything else reaches the Worker.
  "assets": { "directory": "./static" },
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "transfers.jeremyhamann.dev", "custom_domain": true }],
  "vars": {
    "APP_ORIGIN": "https://transfers.jeremyhamann.dev"
  },
  // Secrets (set by the deploy workflow): DATABASE_URL, AUTH_SECRET, DEMO_RESET_TOKEN.
  "containers": [
    {
      "class_name": "TransferApp",
      "image": "../Dockerfile",
      "image_build_context": "../../..",
      // One small instance (1/4 vCPU, 1 GiB); it sleeps after 10 idle minutes (see TransferApp.sleepAfter).
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TRANSFER_APP", "class_name": "TransferApp" }]
  },
  "exports": {
    "TransferApp": { "type": "durable-object", "storage": "sqlite" }
  },
  // Per-visitor ceiling at the edge, before anything reaches the container (counted per Cloudflare location):
  // far above normal use, so it only stops floods, which would otherwise keep the container awake. Higher
  // than Trade Request's 300: a Next.js page load fetches many script chunks and prefetches linked pages.
  "ratelimits": [{ "name": "VISITOR_LIMIT", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }],
  // The demo's only scheduled job: the nightly reset.
  "triggers": { "crons": ["0 7 * * *"] },
  "observability": { "enabled": true }
}
