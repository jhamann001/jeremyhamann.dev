# =============================================================================
# Database
# =============================================================================
# Password for the local Postgres container (see docker-compose.yml). The
# compose file has no fallback — an empty value will abort `docker compose up`.
POSTGRES_PASSWORD=change-me-locally

# Standard PostgreSQL connection string
DATABASE_URL="postgresql://postgres:change-me-locally@localhost:5432/transfer_tracker?schema=public"

# =============================================================================
# Auth (NextAuth + Google OAuth)
# =============================================================================
# Generate with: openssl rand -base64 48
# MUST NOT be the string `dev-secret-change-in-production` in any environment;
# src/lib/auth.ts asserts this at startup in production.
NEXTAUTH_SECRET=your-secret-here

# Full URL where the app is hosted (include port for local dev)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# Fee Store Database API (for fee reimbursements)
# =============================================================================
# Generate an API key at: the fee store settings page
FEE_STORE_API_KEY=fee_store_ak_xxxxxxxxxxxxxxxxxxxxx

# Base URL for Fee Store DB REST API (no trailing slash)
FEE_STORE_DB_URL=https://fee-store.example/api/v1/db/fee_store_db

# Table ID for your fees/reimbursements table
FEE_STORE_FEES_TABLE_ID=your_table_id_here

# =============================================================================
# GCP Asset Mapping (statement-pipeline Cloud Run)
# =============================================================================
# Base URL for the statement-pipeline Cloud Run service (OIDC auth via service account)
GCP_ASSET_MAPPING_URL=https://statement-pipeline-XXXXX.run.app

# =============================================================================
# Distributed rate limiter (optional — falls back to in-memory if unset)
# =============================================================================
# Provision at https://console.upstash.com/ → Redis database → "REST API" tab
# Leave empty in local dev; production MUST set both so rate limits survive
# horizontal scale-out on Cloud Run.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Remote MCP Connector (Claude)
# =============================================================================
# Global runtime flag. Keep disabled until OAuth + Claude Desktop smoke tests pass.
MCP_ENABLED=0

# Public URL of the deployed MCP Cloud Run service, no trailing slash.
MCP_PUBLIC_URL=http://localhost:3001

# Local MCP server port for `npm run mcp:dev`.
MCP_PORT=3001

# Generate with: openssl rand -base64 48
# Used as the HMAC pepper for OAuth codes, access tokens, and refresh tokens.
MCP_TOKEN_PEPPER=dev-mcp-token-pepper

# Optional CORS origin override for the MCP service. Defaults to * for broad
# Claude client compatibility.
MCP_CORS_ORIGIN=

# =============================================================================
# Daily Slack digest (ticket)
# =============================================================================
# Incoming-webhook URL that POST /api/cron/daily-digest sends its summary to.
# Create at https://api.slack.com/apps → your app → Incoming Webhooks → "Add
# New Webhook to Workspace" and pick the channel. Treat the full URL as a
# secret — anyone who has it can post to that channel.
SLACK_WEBHOOK_URL=

# Bearer secret the cron caller must present in `Authorization: Bearer …`.
# Generate with: openssl rand -base64 48
# The route's Proxy bypass is keyed on the exact path; the bearer token
# is what actually gates execution. Leave blank locally if you don't need to
# exercise the cron route.
DIGEST_CRON_TOKEN=

# Cedar Ridge client identity (ticket). Enable only after verified directory
# provisioning and the approved historical backfill / catch-up.
CLIENT_IDENTITY_ENABLED=false
# Enable only after the directory has synced CRM stages. Search includes
# Client and Lost Client; stored links and account memberships are preserved.
CLIENT_SEARCH_CRM_ONLY=false
CLIENT_IDENTITY_PENDING_ACCOUNT_POLICY=PENDING_ACCOUNT_OPENING_ONLY
# Saved-card-only service credential, dedicated to this directory.
CLIENT_DIRECTORY_WAREHOUSE_URL=
CLIENT_DIRECTORY_WAREHOUSE_API_KEY=
CLIENT_DIRECTORY_WAREHOUSE_CARD_ID=
CLIENT_DIRECTORY_QUERY_FINGERPRINT=
CLIENT_DIRECTORY_MAX_REMOVAL_PERCENT=0
CLIENT_DIRECTORY_SYNC_TOKEN=
# Jeremy accepted upstream coverage based on OPS_PORTAL/Trade Request on 2026-09-25.
# Freshness here means a complete successful fetch, not proven CDC health.
CLIENT_DIRECTORY_FRESHNESS_POLICY=FETCH_SUCCESS
# Hourly refresh; stop identity writes after three hours without a successful pull.
CLIENT_DIRECTORY_MAX_AGE_SECONDS=10800
# Required only for optional UPSTREAM_VERIFIED policy with a genuine heartbeat.
CLIENT_DIRECTORY_SOURCE_MAX_AGE_SECONDS=

# Full-history ACAT evidence API: independent of existing machine read grants.
# Production deployment uses environment=production; the isolated test executable
# uses synthetic and an explicit MACHINE_AUTH_AUDIENCE for its private URL.
TRANSFER_LINKAGE_ENABLED=false
TRANSFER_LINKAGE_ENVIRONMENT=production
TRANSFER_LINKAGE_ALLOWED_SAS=

# =============================================================================
# Demo (portfolio): synthetic data, with stand-ins for every outside service
# =============================================================================
# NEXT_PUBLIC_DEMO_MODE=on            # demo screens: Outbox, uploads off, sample report (set at build and run time)
# DEMO_STAND_INS=on                   # start the loopback stand-ins (src/lib/demo/stand-ins)
# STAND_INS_PORT=8090
# DEMO_RESET_TOKEN=                   # bearer for POST /api/internal/demo-reset, the nightly reset
# DEMO_UNIVERSE_PATH=                 # synthetic/out/universe.json; defaults to the repo copy
# RATE_LIMIT_MEMORY_FALLBACK=true     # one instance, so the in-memory limiter is accurate
# Point the integrations at the stand-ins (keys and the webhook path are any random values):
# FEE_STORE_DB_URL=http://127.0.0.1:8090/fee-store
# FEE_STORE_FEES_TABLE_ID=fee_credits
# CLIENT_IDENTITY_ENABLED=true
# CLIENT_DIRECTORY_WAREHOUSE_URL=http://127.0.0.1:8090/warehouse
# CLIENT_DIRECTORY_WAREHOUSE_CARD_ID=101
# CLIENT_DIRECTORY_QUERY_FINGERPRINT=cc46878c57dd97d3b0adf91ed2b9d29a3a66ebd01f1fce77dcc24753a8b14e6e
# CLIENT_DIRECTORY_FRESHNESS_POLICY=FETCH_SUCCESS
# CLIENT_DIRECTORY_MAX_AGE_SECONDS=604800   # synced only by the nightly reset
# GCP_ASSET_MAPPING_URL=http://127.0.0.1:8090
# SLACK_WEBHOOK_URL=http://127.0.0.1:8090/slack/services/T0DEMO/B0DEMO/<random>
