# Copy to .env for local dev (`cp .env.example .env`). NEVER commit real secrets.
# Prod values live in GCP Secret Manager, injected at runtime.

# --- Database (local docker-compose: trust auth, synthetic data only) ---
# App runtime: least-privilege role app_rw — Postgres RLS is enforced against it.
DATABASE_URL="postgresql://app_rw@localhost:5432/aoa?schema=app"
# Migrations + seed: owner role aoa (creates schemas, roles, tables, grants, RLS).
DIRECT_DATABASE_URL="postgresql://aoa@localhost:5432/aoa?schema=app"
# Prod: Cloud SQL via private IP / connector (set in Secret Manager)

# --- Ingest (n8n → mirror; Phase D) ---
# Ingest routes' dedicated connection: ingest_rw role (local trust auth).
# Prod value lives in Secret Manager (wired in D-3).
INGEST_DATABASE_URL="postgresql://ingest_rw@localhost:5432/aoa"
# CRM identity sweeps use a separate, narrowly-granted machine role. This value
# must never fall back to DATABASE_URL or INGEST_DATABASE_URL.
CRM_RECONCILER_DATABASE_URL="postgresql://identity_reconciler@localhost:5432/aoa?schema=app"
# Bearer token n8n presents on POST /api/ingest/*. Unset -> endpoints 401
# fail-closed. Mint one: openssl rand -base64 32. Prod value in Secret
# Manager (D-3).
INGEST_TOKEN=""

# --- Warehouse (tkt account-AUM cron pull) ---
# The daily cron (POST /api/cron/account-aum) PULLS per-account AUM from saved
# Warehouse card 6436. Auth on the cron trigger itself REUSES INGEST_TOKEN above.
# No trailing slash. Prod values live in Secret Manager (warehouse-url /
# warehouse-api-key). Leave blank locally unless exercising the live pull.
WAREHOUSE_URL="https://warehouse.example"
# Warehouse API key sent as the `x-api-key` header. NEVER commit a real key.
WAREHOUSE_API_KEY=""

# --- statement-pipeline (Phase-1 asset-mapping ingest cron pull) ---
# The ~30-min business-hours cron (POST /api/cron/asset-map) PULLS the
# household -> accounts[] -> positions[] asset-mapping tree from the statement-pipeline's
# OIDC-gated bulk endpoint (GET /api/v1/households) and mirrors it into
# mirror.acat_asset_map_*. This is the OIDC AUDIENCE + request base URL — set it
# to the pipeline's Cloud Run base URL (no trailing slash). Keyless: aoa-run@
# mints the ID token (ADC locally); the pipeline allow-lists aoa-run@ in its
# POSITIONS_API_ALLOWED_SAS. UNSET -> the cron returns 503 config_error (there is
# no default URL yet). Auth on the cron trigger itself REUSES INGEST_TOKEN above.
# Prod value lives in Secret Manager. Depends on statement-pipeline PR #29.
STATEMENT_PIPELINE_URL=""
# Run identity sync on the same import (ticket). Only "1" enables either.
# ENABLED alone = preview: read-only census + aggregate diagnostics, no identity
# writes. WRITES additionally applies a complete census in a separate tx after
# the base import commits. dryRun=1 never writes in any combination.
ASSET_MAP_RUN_IDENTITY_ENABLED="0"
ASSET_MAP_RUN_IDENTITY_WRITES_ENABLED="0"
# ticket in-app asset-mapping read slice (Admin/Operations only). Keep "0".
EPIC_AOA_ASSET_MAPPING_READ="0"
# ticket in-app asset-mapping edits (Admin/Operations; needs the read flag). Keep "0".
EPIC_AOA_ASSET_MAPPING_EDITS="0"
# ticket in-app asset-mapping destinations and spreadsheet (Admin/Operations; needs the read flag). Keep "0".
EPIC_AOA_ASSET_MAPPING_DESTINATIONS="0"
# ticket in-app client linking (Admin/Operations; needs the read flag). Keep "0".
EPIC_AOA_ASSET_MAPPING_CLIENT_LINKING="0"
# In-app asset-mapping PDF, Drive save, and manual scan (needs the read flag). Keep "0".
EPIC_AOA_ASSET_MAPPING_DOCUMENTS="0"
# ticket epic release: Asset Mapping navigation opens /asset-mapping instead of the external app. Independent of the slice flags. Keep "0".
EPIC_AOA_ASSET_MAPPING_WORKSPACE="0"
# ticket on-demand import: a finished scan and a confirmed account-type save run the import, then the open household reloads. Independent of the other flags. Keep "0".
EPIC_AOA_ASSET_MAPPING_ON_DEMAND_IMPORT="0"

# --- Transfer Tracker identity-based linking (separate from asset-map ingest) ---
# Both controls default off. Review enables /acat-link-review and read-only
# cron preview; automation additionally permits guarded link writes.
# Explicit HTTPS origin + installation + environment are mandatory; no fallback.
# Development uses only the isolated synthetic producer. IDs stay server-side.
ACAT_LINK_REVIEW="0"
ACAT_AUTO_LINK="0"
TRANSFER_LINKAGE_URL=""
TRANSFER_LINKAGE_INSTALLATION_ID=""
TRANSFER_LINKAGE_ENVIRONMENT="synthetic"
# Recurring job uses exact route audience and a dedicated Google service identity.
# Manual cron calls may still use INGEST_TOKEN. Neither credential enters Git.
ACAT_LINK_SCHEDULER_AUDIENCE=""
ACAT_LINK_SCHEDULER_SERVICE_ACCOUNT=""

# --- Trade-Request app (client/household/transfer trade-request panels) ---
# Base URL of the Trade-Request app's OIDC-gated machine endpoint
# (GET /api/machine/trade-requests). Used verbatim as BOTH the OIDC token
# audience (MUST equal the Trade-Request service's MACHINE_AUDIENCE byte-for-byte)
# and the request path prefix (no trailing slash). Keyless: aoa-run@ mints the
# ID token (ADC locally); the app allow-lists aoa-run@ in its ALLOWED_MACHINE_SA.
# Defaults to the prod Cloud Run URL if unset. Consumed by lib/data/trade-requests.ts.
TRADE_REQUEST_API_URL="https://trade-request-123456789012.us-central1.run.app"
# DEV-ONLY: return bundled fixtures instead of calling the endpoint (a local
# laptop has no aoa-run@ metadata identity). Inert in production (NODE_ENV guard).
TRADE_REQUEST_FIXTURE="0"
# ticket epic release: Trade Requests navigation opens the native /trade-requests
# workspace for ADMIN, OPERATIONS and ADVISOR. Keep "0".
EPIC_TRADE_REQUESTS_WORKSPACE="0"
# ticket: New Request copy without the engine or execution plans. Needs the
# Trade Request backend move epic switch EPIC_TRADE_REQUESTS_BACKEND_MOVE="1"
# too; turned on only where standalone plan generation is off. Keep "0".
TRADE_REQUESTS_NO_PLAN_COPY="0"
# ticket: the Trade Request backend move epic master (ticket) and ADMIN
# trader-roster administration; both exact "1", default off. The roster route
# also needs Trade Requests AOA-served.
# EPIC_TRADE_REQUESTS_BACKEND_MOVE=
# TRADE_REQUESTS_ROSTER_ADMIN=
# ticket: AOA Trade Request Slack posts (only while AOA-served, epic master
# "1"). Breaker on unless "0"; nothing posts without a bot token and channel.
# Never set real values locally; tests stub Slack.
# TRADE_REQUESTS_SLACK=
# TRADE_REQUEST_SLACK_BOT_TOKEN=
# TRADE_REQUEST_SLACK_CHANNEL_ID=
# ticket: AOA's weekday Trade Request digest (also needs EPIC_TRADE_REQUESTS_BACKEND_MOVE="1" and AOA as digest
# sender in trade_request.serving_state). Keep "0". Terraform sets the scheduler audience and identity; leave empty.
TRADE_REQUESTS_DIGEST_JOB="0"
TRADE_REQUEST_DIGEST_SCHEDULER_AUDIENCE=""
TRADE_REQUEST_DIGEST_SCHEDULER_SERVICE_ACCOUNT=""
# ticket: deliver saved custodian revisions to Tracker. Exact "1", default off.
# Terraform binds the production value. The scheduler audience and identity stay
# empty until the paused job is provisioned.
ROLLOUT_CUSTODIAN_CHANGE_DELIVERY_TKT404="0"
CUSTODIAN_PROJECTION_SCHEDULER_AUDIENCE=""
CUSTODIAN_PROJECTION_SCHEDULER_SERVICE_ACCOUNT=""
# Access reconciliation (scripts/trade-requests/reconcile-access.ts): optional
# JSON array of accepted emails, kept outside the repository; never printed.
# TRADE_REQUEST_ACCESS_EXCEPTIONS_FILE=
# Delegated Trade Request calls (/api/aoa). Audience defaults to
# ${TRADE_REQUEST_API_URL}/api/aoa and must equal the service's AOA_DELEGATED_AUDIENCE.
TRADE_REQUEST_DELEGATED_AUDIENCE=""
# LOCAL ONLY: HS256 key shared with a local service's AOA_DELEGATED_LOCAL_KEY.
# Ignored when NODE_ENV=production. Never set in any deployed environment.
TRADE_REQUEST_DELEGATED_LOCAL_KEY=""

# --- Feed freshness monitor (tkt account-AUM health check) ---
# OPTIONAL. The freshness monitors (GET/POST /api/cron/health/aum-freshness and
# /api/cron/health/risk-free-rate) alert when the account-AUM or Treasury series
# falls behind. If this Slack incoming-webhook URL is set, a STALE verdict POSTs
# a best-effort alert; if UNSET, no Slack is sent — the monitor still returns
# 503 and writes the audit row. Monitor auth REUSES INGEST_TOKEN above. Prod and
# dev values (if used) live only in their respective Secret Manager projects.
SLACK_ALERT_WEBHOOK_URL=""

# Operations UI defaults off. Production requires APP_ENV="prod", explicit
# OPERATIONS_PRODUCTION_ENABLED="1", the parent and the selected child flags.
# Enablement is a separately approved step; never identify production as dev.
OPERATIONS_PRODUCTION_ENABLED="0"
OPERATIONS_TOOLS="0"
OPERATIONS_TRADE_RECONCILIATION="0"
OPERATIONS_FEE_REQUESTS="0"

# Operations request alerts: approved wording, but disabled until explicit
# activation. Never reuse the health webhook/ingest token. Dev can capture
# synthetic outbox rows for tests but can never deliver to the production channel.
OPERATIONS_SLACK_CAPTURE_ENABLED="false"
OPERATIONS_SLACK_DELIVERY_ENABLED="false"
OPERATIONS_SLACK_BOT_TOKEN=""
OPERATIONS_SLACK_SCHEDULER_SERVICE_ACCOUNT=""

# --- Auth.js ---
# Optional for local dev: if left blank, the app uses a built-in dev-only
# fallback so `npm run dev` just works. REQUIRED in prod (set in Secret Manager).
# To use a real one locally: npx auth secret  (or: openssl rand -base64 33)
AUTH_SECRET=""
# Base URL of the app (local default shown)
AUTH_URL="http://localhost:3000"

# --- Okta OIDC (one app per environment) ---
AUTH_OKTA_ID=""
AUTH_OKTA_SECRET=""
AUTH_OKTA_ISSUER="https://YOUR_ORG.okta.com/oauth2/default"

# --- Dev persona login on a DEPLOYED instance (aoa-dev only) ---
# Locally, dev login is always on (NODE_ENV != production). On a deployed
# instance (NODE_ENV=production) it is OFF unless AUTH_DEV_LOGIN="1" — that is
# how the aoa-dev service runs the persona picker without Okta. NEVER set this
# on the prod service. When "1": Okta is bypassed, sessions are JWT, no Prisma
# adapter, and the seeded persona users must exist in that instance's DB.
AUTH_DEV_LOGIN="0"

# --- Environment banner ---
# Names the environment for the sticky top banner (EnvBanner). "dev" or
# "staging" renders a visible non-prod bar; unset / "prod" renders nothing.
# Runtime var (not NEXT_PUBLIC_*): read server-side, so it needs no rebuild.
APP_ENV=""

# --- CRM links ---
# Non-secret browser-visible Salesforce origin used for direct task links.
# Must be an HTTPS *.lightning.force.com or *.my.salesforce.com origin with no
# path/query. If unset, AOA uses CedarRidge's production CRM origin.
NEXT_PUBLIC_CRM_ORIGIN="https://crm.example"

# --- Client Portrait dev prototypes ---
# Enables the synthetic-data Dual-View and Illustration experiences only when
# APP_ENV="dev" too. Production fails closed even if this is accidentally set.
CLIENT_PORTRAIT_EXPERIMENTS="0"

# --- Tasks demo sample rows (ticket) ---
# Shows the made-up workflow sample rows on /tasks in a separate, uncounted
# "Demo sample workflow (dev only)" block. Needs APP_ENV="dev" too; production
# fails closed. Default off: the Tasks page shows only real, saved tasks.
TASKS_SAMPLE_ROWS="0"

# --- CRM relationship layer (ticket planning) ---
# Independent server-side rollback seams for the additive CRM identity and
# relationship initiative. Phase 2A consumes CRM_IDENTITY_READS for typed-ID
# detail resolution, and Phase 2B uses it for the Operations/Admin CRM Explorer
# navigation and pages. Relationships, Documents, and Reporting additionally
# drive visibly synthetic UI prototypes, but only when APP_ENV="dev". Every
# flag is default OFF and only the exact string "1" enables it.
# Keep all unset/0 until the corresponding reviewed phase is merged, migrated,
# verified in dev, and separately approved. CRM_EBAC_ENFORCE is the final and
# most sensitive gate: read-only graph availability never implies enforcement.
CRM_IDENTITY_READS="0"
# Phase 3A automatic assignment + exact-parent exception reconciliation.
# Requires CRM_RECONCILER_DATABASE_URL; independent from the read-only explorer.
CRM_IDENTITY_RECONCILIATION="0"
# Independent first-write gate. Enable only after a successful reviewed dry run.
CRM_IDENTITY_RECONCILIATION_WRITES="0"
# Independent duplicate-candidate persistence gate. Default OFF still returns
# rollback-backed detector preview counts during identity reconciliation.
CRM_DUPLICATE_DETECTOR_WRITES="0"
# Phase 4C relationship snapshot preview and independent live-write gate.
# Completeness is supplied explicitly per source on each invocation.
CRM_RELATIONSHIP_RECONCILIATION="0"
CRM_RELATIONSHIP_RECONCILIATION_WRITES="0"
CRM_RELATIONSHIPS="0"
CRM_DOCUMENTS="0"
CRM_CONSENT="0"
CRM_EBAC_ENFORCE="0"

# --- Central Operations review queue ---
# REVIEW_QUEUE exposes the Operations/Admin-only page and workflow actions.
# REVIEW_QUEUE_MATERIALIZATION independently enables the token-authenticated,
# bounded detector at POST /api/cron/review-queue. Keep both dark until the
# migration is applied; materialization may be enabled first for shadow checks.
REVIEW_QUEUE="0"
REVIEW_QUEUE_MATERIALIZATION="0"
# Non-secret exact OIDC assertions for the dedicated Cloud Scheduler identity.
# Terraform supplies these in deployed environments.
REVIEW_QUEUE_SCHEDULER_AUDIENCE=""
REVIEW_QUEUE_SCHEDULER_SERVICE_ACCOUNT=""
# Terraform derives this from an enabled, unpaused recurring scheduler. Manual
# calls must leave it OFF so Data Health cannot infer schedule freshness.
REVIEW_QUEUE_SCHEDULER_ACTIVE="0"
# Operations/Admin-only source evidence dashboard.
DATA_HEALTH="0"
CRM_REPORTING="0"

# --- Canonical-dev transfer-card visibility ---
# Canonical cloud dev may retain the repository's stable DEMO-T-* seed rows for
# recovery while showing only approved deal-sourced transfer cards. This flag is
# read-only: it never deletes or archives the demo rows. Leave OFF in local
# development and production; the isolated dev Terraform stack owns the cloud
# dev value.
HIDE_DEMO_TRANSFER_CARDS="0"

# --- Vertex AI (Gemini) — server-side communication drafting ---
# Keyless: aoa-run@ mints a cloud-platform access token on Cloud Run; locally use
# `gcloud auth application-default login` + `gcloud config set billing/quota_project
# ops-portal` (else the API errors SERVICE_DISABLED on the ADC fallback project).
# Feature flag for the drafting UI surfaces (default OFF; only "1" enables). The
# /api/health/ai probe is INDEPENDENT of this flag (ingest-token gated).
AI_DRAFTING="0"
# AI meeting prep (Command Center → Meetings → Generate prep). DELIBERATELY a
# SEPARATE flag from AI_DRAFTING: prep persists a PII brief in app.meeting_prep,
# where comms drafting only renders text into an editable field, so the two must
# be flippable independently. Default OFF; only "1" enables. Gates the UI
# affordance, the generateMeetingPrep Server Action AND the app.meeting_prep
# read. Needs COMMAND_CENTER_MEETINGS_LIVE=1 too — the affordance only exists on
# live appointment rows.
AI_MEETING_PREP="0"
# GCP project for Vertex. Falls back to GOOGLE_CLOUD_PROJECT / GCLOUD_PROJECT
# (auto-set on Cloud Run). Set explicitly for local dev.
VERTEX_PROJECT="ops-portal"
# Location. Gemini 3.x is served on "global". Keep the primary and fallback at
# the same endpoint so a 404 fallback does not require a second location.
VERTEX_LOCATION="global"
# Primary model + fallback (used when the primary 404s at this location).
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash"

# --- Trade Request records copy (ticket; operator command only) ---
# scripts/trade-requests/copy.ts reads the standalone Trade Request database here
# and writes AoA's trade_request schema through DIRECT_DATABASE_URL. Never set in
# the app runtime.
# TRADE_REQUEST_SOURCE_DATABASE_URL=""
# Opt-in local scratch-database suites (test/trade-request-*.integration.test.ts);
# "1" enables them and TRADE_REQUEST_SERVICE_DIR points at a trade-request checkout.
# TRADE_REQUEST_COPY_TEST_DB=""
# TRADE_REQUEST_SERVICE_DIR=""

# Trade Request drift job (ticket): off | shadow | live; needs EPIC_TRADE_REQUESTS_BACKEND_MOVE="1".
TRADE_REQUESTS_DRIFT_JOB="off"
# Exclusion-overlap diagnostic: exactly "1" serves it.
TRADE_REQUEST_DRIFT_EXCLUSION_OVERLAP_ENABLED="0"
# TRADE_REQUEST_DRIFT_SCHEDULER_AUDIENCE=""
# TRADE_REQUEST_DRIFT_SCHEDULER_SERVICE_ACCOUNT=""
# TRADE_REQUEST_DRIFT_SLACK_CHANNEL_ID=""
# Drift inputs keep the standalone names: WAREHOUSE_{CONTACTS,INVESTMENTS,BALANCES,STOCK_RECORD}_QUESTION_ID,
# WAREHOUSE_COST_BASIS_DB_IDS, MERIDIAN_SNAPSHOT_{SOURCE,BUCKET,S3_BUCKET,S3_REGION,S3_PREFIX}, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY. Never real values here.

# ticket: Drift and Roster screens in the Trade Requests workspace. Needs
# EPIC_TRADE_REQUESTS_BACKEND_MOVE="1"; Roster also needs TRADE_REQUESTS_ROSTER_ADMIN="1".
# The screens appear only while Trade Requests are AOA-served. Keep "0".
TRADE_REQUESTS_DRIFT_VIEW="0"
