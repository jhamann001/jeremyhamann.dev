{
  "name": "always-on-advice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/apply-next-middleware-body-fix.cjs",
    "dev": "next dev",
    "prebuild": "node scripts/apply-next-middleware-body-fix.cjs",
    "build": "next build",
    "postbuild": "node scripts/apply-next-middleware-body-fix.cjs --check-standalone --next-package .next/standalone/node_modules/next",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run && npm run test:middleware-body",
    "test:middleware-body": "node --test test/framework/next-middleware-body-fix.test.cjs && node test/framework/next-middleware-body-finalization-runtime.cjs",
    "test:db": "vitest run --no-file-parallelism",
    "test:e2e:smoke": "playwright test --project=deployed-smoke",
    "test:e2e:critical": "playwright test --config=playwright.critical.config.ts",
    "test:e2e:progressive": "playwright test --config=playwright.progressive.config.ts",
    "test:e2e:operations": "playwright test --config=playwright.operations.config.ts",
    "test:e2e:trade-requests": "playwright test --config=playwright.trade-requests.config.ts",
    "test:watch": "vitest",
    "operations:legacy-import": "tsx scripts/import-legacy-operations.ts",
    "custodian:snapshot-import": "tsx scripts/import-custodian-snapshot.ts",
    "custodian:snapshot-report": "tsx scripts/report-custodian-snapshot-import.ts",
    "operations:legacy-import:job": "tsx scripts/import-legacy-operations-job.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "demo:seed": "node --require ./scripts/server-only-shim.cjs --import tsx scripts/demo-seed.ts",
    "demo:reset": "node --require ./scripts/server-only-shim.cjs --import tsx scripts/demo-seed.ts",
    "demo:logins": "node --import tsx scripts/demo-logins.ts",
    "demo:owner-url": "node --import tsx scripts/demo-owner-url.ts",
    "demo:samples": "node --require ./scripts/server-only-shim.cjs --import tsx scripts/demo-samples.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "3.1108.0",
    "@google-cloud/storage": "8.2.0",
    "@prisma/client": "^6.2.1",
    "cron-parser": "5.10.1",
    "gcp-metadata": "8.1.2",
    "google-auth-library": "^10.9.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "read-excel-file": "9.3.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@sentry/node": "^11.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.22",
    "jsdom": "^29.1.1",
    "prisma": "^6.2.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      ".": "14.2.35",
      "glob": "10.5.0"
    },
    "deepmerge-ts": "8.0.0",
    "postcss": "^8.5.18",
    "sharp": "^0.35.4",
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@emnapi/wasi-threads": "1.2.2",
    "uuid": "^11.1.1"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@emnapi/wasi-threads": "1.2.2"
  }
}
