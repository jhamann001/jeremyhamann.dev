// ---- App-owned: central Operations review workflow ----------------------
//
// Authoritative records remain in Trade Request and the CRM identity layer.
// These rows contain only a deterministic detector key, a redacted derived
// snapshot, and the human workflow/provenance AOA owns.
enum ReviewQueueSource {
  TRADE_REQUEST
  CRM_IDENTITY

  @@schema("app")
}

enum ReviewQueueStatus {
  NEW
  IN_REVIEW
  RESOLVED
  SNOOZED

  @@schema("app")
}

model ReviewQueueItem {
  id                 String             @id @default(cuid())
  detector_key       String             @unique @db.Char(64)
  subject_key        String             @db.Char(64)
  source             ReviewQueueSource
  exception_type     String             @db.VarChar(64)
  source_record_ref  String?            @db.VarChar(128)
  resolution_href    String             @db.VarChar(512)
  summary            String             @db.VarChar(180)
  source_snapshot    Json               @default("{}")
  source_active      Boolean            @default(true)
  status             ReviewQueueStatus  @default(NEW)
  assigned_to        String?            @db.VarChar(320)
  resolution_note    String             @default("") @db.VarChar(1000)
