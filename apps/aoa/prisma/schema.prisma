// ---- App-owned: Trade Reconciliation completed-run archive --------------
//
// A run is an immutable, redacted snapshot of one completed account-aware
// reconciliation. Full account IDs never persist: payload rows carry only a
// masked account suffix. Notes and break decisions are append-only events so
// operational context never rewrites the raw result.
model TradeReconciliationRun {
  id                      String                           @id @default(cuid())
  run_date                DateTime                         @db.Date
  business_date           DateTime                         @db.Date
  algorithm_version       String                           @db.VarChar(32)
  source_scope_version    String                           @db.VarChar(32)
  source_digest           String                           @db.Char(64)
  source_commit_sha       String                           @db.VarChar(64)
  apex_record_count       Int
  meridian_record_count Int
  raw_match_count         Int
  exception_count         Int
  raw_match_rate          Decimal                          @db.Decimal(7, 4)
  payload                 Json
  completed_by            String?                          @db.VarChar(320)
  completed_at            DateTime                         @default(now()) @db.Timestamptz(6)
  legacy_source           String?                          @db.VarChar(48)
  legacy_source_id        String?                          @db.VarChar(80)
  legacy_unmatched_apex   Int?
  legacy_unmatched_alpha  Int?
  legacy_match_rate       Decimal?                         @db.Decimal(20, 15)
  review_events           TradeReconciliationReviewEvent[]
  note_events             TradeReconciliationNoteEvent[]

  @@unique([run_date, business_date, algorithm_version, source_digest], map: "trade_reconciliation_run_idempotency_key")
  @@unique([legacy_source, legacy_source_id], map: "trade_reconciliation_run_legacy_key")
  @@index([run_date(sort: Desc), completed_at(sort: Desc)])
  @@index([business_date(sort: Desc), completed_at(sort: Desc)])
  @@index([completed_at(sort: Desc)])
  @@map("trade_reconciliation_run")
  @@schema("app")
}

model TradeReconciliationReviewEvent {
  id              String                 @id @default(cuid())
  run_id          String
  row_fingerprint String                 @db.Char(64)
  classification  String                 @db.VarChar(64)
  explanation     String                 @db.VarChar(1000)
  reviewer_email  String?                @db.VarChar(320)
  created_at      DateTime               @default(now()) @db.Timestamptz(6)
  run             TradeReconciliationRun @relation(fields: [run_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([run_id, row_fingerprint, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@map("trade_reconciliation_review_event")
  @@schema("app")
}

model TradeReconciliationNoteEvent {
  id           String                 @id @default(cuid())
  run_id       String
  note         String                 @db.VarChar(1000)
  author_email String?                @db.VarChar(320)
  created_at   DateTime               @default(now()) @db.Timestamptz(6)
  run          TradeReconciliationRun @relation(fields: [run_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([run_id, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@map("trade_reconciliation_note_event")
  @@schema("app")
}

// ---- App-owned: Fee Credit & Service Guarantee request workflow --------
//
// These are human-submitted operational instructions, not calculated fees.
// The selected account references are opaque mirror.client_account_aum keys;
// full account numbers are resolved only inside the Operations-only read seam.
enum OperationsFeeRequestKind {
  FEE_CREDIT
  SERVICE_GUARANTEE
  BILLING_EXCEPTION
  LARGE_HOUSEHOLD_EXCEPTION

  @@schema("app")
}

enum OperationsFeeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  CREDITED

  @@schema("app")
}

enum OperationsFeeRequestScope {
  CLIENT
  HOUSEHOLD

  @@schema("app")
}

model OperationsFeeRequest {
  id                       String                      @id @default(cuid())
  kind                     OperationsFeeRequestKind
  status                   OperationsFeeRequestStatus  @default(PENDING)
  scope                    OperationsFeeRequestScope   @default(CLIENT)
  client_sf_id             String                      @db.VarChar(64)
  legacy_household_sf_id   String?                     @db.VarChar(64)
  legacy_client_name       String?                     @db.VarChar(160)
  account_ids              String[]
  fee_types                String[]                    @default([])
  fee_amount               Decimal?                    @db.Decimal(14, 2)
  waiver_start             DateTime?                   @db.Date
  waiver_duration_months   Int?
  indefinite_duration      Boolean                     @default(false)
  reason                   String                      @default("") @db.VarChar(2000)
  relevant_ticket_refs     String[]                    @default([])
  submitted_by_email       String?                     @db.VarChar(320)
  submitted_by_name        String?                     @db.VarChar(160)
  submitted_by_role        String                      @db.VarChar(32)
  submitted_at             DateTime                    @default(now()) @db.Timestamptz(6)
  reviewed_by_email        String?                     @db.VarChar(320)
  reviewed_by_name         String?                     @db.VarChar(160)
  reviewed_at              DateTime?                   @db.Timestamptz(6)
  credited_at              DateTime?                   @db.Date
  apex_request_id          String?                     @db.VarChar(80)
  legacy_apex_request_text String?                     @db.VarChar(1000)
  completed_by_email       String?                     @db.VarChar(320)
  completed_by_name        String?                     @db.VarChar(160)
  completed_at             DateTime?                   @db.Timestamptz(6)
  legacy_source            String?                     @db.VarChar(48)
  legacy_source_id         String?                     @db.VarChar(80)
  legacy_source_digest     String?                     @db.Char(64)
  submission_key           String?                     @db.VarChar(36)
  submission_digest        String?                     @db.Char(64)
  created_at               DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                    @updatedAt @db.Timestamptz(6)
  events                   OperationsFeeRequestEvent[]
  slack_notification       OperationsSlackNotification?
  transfer_reimbursements  TransferFeeReimbursement[]

  @@index([status, submitted_at(sort: Desc)])
  @@index([client_sf_id, submitted_at(sort: Desc)])
  @@index([legacy_household_sf_id, submitted_at(sort: Desc)])
  @@unique([legacy_source, legacy_source_id], map: "operations_fee_request_legacy_key")
  @@unique([submitted_by_email, submission_key], map: "operations_fee_request_submission_key")
  @@map("operations_fee_request")
  @@schema("app")
}

model OperationsFeeRequestEvent {
  id          BigInt                      @id @default(autoincrement())
  request_id  String
  action      String                      @db.VarChar(48)
  actor_email String?                     @db.VarChar(320)
  actor_name  String?                     @db.VarChar(160)
  actor_role  String                      @db.VarChar(32)
  from_status OperationsFeeRequestStatus?
  to_status   OperationsFeeRequestStatus?
  detail      Json                        @default("{}")
  at          DateTime                    @default(now()) @db.Timestamptz(6)
  request     OperationsFeeRequest        @relation(fields: [request_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  slack_notification OperationsSlackNotification?

  @@index([request_id, at(sort: Desc)])
  @@index([at(sort: Desc)])
  @@map("operations_fee_request_event")
  @@schema("app")
}

// Only post-cutover live submissions are captured. No message body or client
// data is duplicated here. Forced RLS and delivery-only column grants live in SQL.
model OperationsSlackNotification {
  request_id      String                    @id
  event_id        BigInt                    @unique
  channel_id      String                    @default("C00OBJK6X0W") @db.VarChar(32)
  status          String                    @default("PENDING") @db.VarChar(16)
  attempts        Int                       @default(0)
  next_attempt_at DateTime                  @default(now()) @db.Timestamptz(6)
  claim_token     String?                   @db.Uuid
  claimed_at      DateTime?                 @db.Timestamptz(6)
  last_code       String?                   @db.VarChar(64)
  slack_ts        String?                   @db.VarChar(40)
  acknowledged_at DateTime?                 @db.Timestamptz(6)
  acknowledged_by_email String?             @db.VarChar(320)
  created_at      DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  request         OperationsFeeRequest      @relation(fields: [request_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  event           OperationsFeeRequestEvent @relation(fields: [event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, next_attempt_at])
  @@map("operations_slack_notification")
  @@schema("app")
}

// ---- App-owned: custodian authority (ticket) ----
// Always-On Advice's custodian profiles, fee rules and their change log. Ids are
// supplied by the snapshot import (Tracker ids) or generated here for new rows.
// Grants, forced RLS (ADMIN/OPERATIONS read, ADMIN write, no DELETE), CHECK
// allow-lists and audit triggers live in the custodian_authority_storage migration.
model CustodianProfile {
  id                       String                    @id @default(cuid())
  name                     String                    @unique
  acat_fee_amount          Float                     @default(0)
  avg_processing_days      Int                       @default(7)
  contact_email            String?
  contact_method           String?
  contact_details          String?
  review_status            String                    @default("VERIFIED")
  transfer_type            String?
  documentation_status     String?
  dtc_number               String?
  receiving_account_number String?
  signature                String?
  letter_of_acceptance     String?
  medallion_required       String?
  liquidation_method       String?
  return_method            String?
  watchouts                String?
  paperwork_on_file        Boolean?
  transfers_to_date        Int?
  merged_into_id           String?
  retired_at               DateTime?                 @db.Timestamptz(6)
  revision                 BigInt
  created_at               DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  merged_into              CustodianProfile?         @relation("CustodianProfileMerge", fields: [merged_into_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  merged_from              CustodianProfile[]        @relation("CustodianProfileMerge")
  fee_rules                CustodianFeeRule[]
  delivering_transfers     Transfer[]
  feeScheduleDocuments     CustodianFeeScheduleDocument[]
  events                   CustodianAuthorityEvent[] @relation("CustodianAuthorityEventCustodian")
  merge_source_events      CustodianAuthorityEvent[] @relation("CustodianAuthorityEventMergedFrom")

  @@map("custodian_profile")
  @@schema("app")
}

model CustodianFeeRule {
  id            String           @id @default(cuid())
  custodian_id  String
  fee_type      String
  account_type  String           @default("ANY")
  transfer_type String           @default("ANY")
  direction     String           @default("ANY")
  amount        Float?
  amount_text   String?
  notes         String?
  documentation String?
  retired_at    DateTime?        @db.Timestamptz(6)
  revision      BigInt
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  updated_at    DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  custodian     CustodianProfile @relation(fields: [custodian_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([custodian_id])
  @@index([custodian_id, account_type])
  @@map("custodian_fee_rule")
  @@schema("app")
}

// Singleton (id = 1). accepted_revision is the last revision Always-On Advice
// committed; confirmed_revision is the last one the transfer copy confirmed.
model CustodianAuthorityState {
  id                 Int      @id @default(1) @db.SmallInt
  accepted_revision  BigInt   @default(0)
  confirmed_revision BigInt   @default(0)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("custodian_authority_state")
  @@schema("app")
}

// Append-only: one row per accepted revision, carrying the post-change
// custodian snapshot that change delivery sends to the transfer copy.
model CustodianAuthorityEvent {
  revision       BigInt            @id
  kind           String
  custodian_id   String
  merged_from_id String?
  payload        Json
  actor_email    String
  created_at     DateTime          @default(now()) @db.Timestamptz(6)
  custodian      CustodianProfile  @relation("CustodianAuthorityEventCustodian", fields: [custodian_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  merged_from    CustodianProfile? @relation("CustodianAuthorityEventMergedFrom", fields: [merged_from_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([custodian_id])
  @@map("custodian_authority_event")
  @@schema("app")
}

model CustodianFeeScheduleDocument {
  id          String           @id
  custodianId String           @map("custodian_id")
  filename    String
  contentType String           @map("content_type")
  content     Bytes
  sha256      String
  byteSize    Int              @map("byte_size")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String           @map("created_by")
  custodian   CustodianProfile @relation(fields: [custodianId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([custodianId])
  @@map("custodian_fee_schedule_document")
  @@schema("app")
}

model CustodianSnapshotImport {
  id             String   @id @default(cuid())
  snapshotSha256 String   @unique @map("snapshot_sha256") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  items          CustodianSnapshotImportItem[]

  @@map("custodian_snapshot_import")
  @@schema("app")
}

model CustodianSnapshotImportItem {
  id          String                  @id @default(cuid())
  importId    String                  @map("import_id")
  import      CustodianSnapshotImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  kind        String
  originalId  String                  @map("original_id")
  byteCount   Int                     @map("byte_count")
  checksum    String                  @db.Char(64)
  revision    BigInt?
  authorityId String                  @map("authority_id")
  confirmed   Boolean                 @default(false)

  @@unique([importId, kind, originalId])
  @@map("custodian_snapshot_import_item")
  @@schema("app")
}
// ---- App-owned: append-only audit log ----
// Append-only is enforced in the DB: the app's role is granted INSERT/SELECT
// only (no UPDATE/DELETE) via the grants in db/rls.sql. Never mutate rows.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  detail     String?

  @@index([at])
  @@index([entityType, entityId])
  @@schema("audit")
}

// Immutable numeric/provenance snapshot written after a performance-report
// calculation completes. This is NOT a PDF and does not claim browser render or
// delivery. It preserves the figures that were calculated under a report id so
// a later reviewer is not forced to regenerate against changed source data.
// DB grants/RLS are hand-authored in the matching migration: report roles may
// INSERT and read their own rows, privileged reviewers may read all rows, and
// nobody in app_rw may UPDATE/DELETE.
model PerformanceReportRecord {
  reportId           String   @id @map("report_id")
  at                 DateTime @default(now()) @db.Timestamptz(6)
  actorEmail         String?  @map("actor_email")
  actorRole          String?  @map("actor_role")
  scope              String
  entityId           String   @map("entity_id")
  reportDate         String   @map("report_date") @db.VarChar(10)
  asOf               String   @map("as_of") @db.VarChar(10)
  snapshotVersion    Int      @map("snapshot_version")
  methodologyVersion String   @map("methodology_version")
  sourceCommitSha    String   @map("source_commit_sha")
  payloadSha256      String   @map("payload_sha256") @db.Char(64)
  payload            Json

  @@index([at])
  @@index([scope, entityId, at])
  @@map("performance_report_record")
  @@schema("audit")
}

// ---- App-owned: database-enforced automatic audit trail (ADR-5) ----
// Raw field-level change log written by the `audit.log_row_change()` Postgres
// trigger on every INSERT/UPDATE/DELETE of the app.* business tables (deal,
// transfer) — so the trail can't be forgotten in app code. This is the
// COMPLEMENTARY raw layer beneath AuditLog (business events, lib/audit.ts).
//
// READ-ONLY in spirit: the app never writes this — the trigger does (as the
// SECURITY DEFINER owner). The GRANTS match AuditLog exactly (SELECT+INSERT, no
// UPDATE/DELETE — append-only/immutable). RLS is NOT a mirror but a deliberate
// improvement: AuditLog has NO row-level security (any app_rw session reads it),
// whereas row_change additionally RLS-restricts SELECT to Ops/Admin/HoA (the raw
// trail can carry full row snapshots, so it is a privileged view). Both grants
// and RLS are hand-authored in the audit_row_change migration (Prisma cannot
// model triggers/policies — the mirror/audit hand-authored-SQL convention,
// exactly as AuditLog's own grants live in the SQL migrations).
// Fields are snake_case DB-native (the deal/transfer raw-SQL seam idiom).
model RowChange {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now()) @db.Timestamptz(6)
  schema_name String
  table_name  String
  op          String // 'INSERT' | 'UPDATE' | 'DELETE'
  row_pk      String? // the row's id
  // UPDATE: { col: { from, to } } for changed cols; INSERT/DELETE: full snapshot.
  changed     Json
  actor_email String? // app.user_email GUC; null for feed (ingest_rw) writes
  actor_role  String? // app.user_role GUC; null for feed writes
  db_role     String // session_user: the writing login role (app_rw/ingest_rw/…)

  @@index([schema_name, table_name, row_pk])
  @@index([at])
  @@index([at(sort: Desc), id(sort: Desc)])
  @@index([table_name, op, actor_email])
  @@map("row_change")
  @@schema("audit")
}

