# syntax=docker/dockerfile:1
# Dedicated one-time operator job. Not aoa-migrate, a web service, or a scheduler.
# Uses Dockerfile.operations-import.dockerignore's explicit context allowlist;
# source exports are excluded before the build context leaves the workstation.
# Reviewed base/package pins and refresh procedure:
# docs/planning/operations-import-container-pins.md
FROM node:22.23.2-alpine3.24@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS dependencies
WORKDIR /app

# Generate Prisma on the same musl/OpenSSL ABI as the final Linux/amd64 image.
# Keep dev dependencies: the unchanged direct Node entrypoint needs tsx.
RUN apk add --no-cache \
    ca-certificates=20261020-r0 \
    libcrypto3=3.5.9-r0 \
    libssl3=3.5.9-r0 \
    openssl=3.5.9-r0 \
    zlib=1.3.2-r1
COPY package.json package-lock.json tsconfig.json ./
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma/migrations ./prisma/migrations
RUN npm ci

# A separate minimal runtime excludes global npm/yarn, headers and build tools.
# Do not copy /usr/local or a complete Node base layer into this stage.
FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS operations-import
WORKDIR /app
RUN apk add --no-cache \
    ca-certificates=20261020-r0 \
    libcrypto3=3.5.9-r0 \
    libssl3=3.5.9-r0 \
    openssl=3.5.9-r0 \
    libgcc=15.2.0-r5 \
    libstdc++=15.2.0-r5 \
    zlib=1.3.2-r1 \
    && addgroup -g 1000 node \
    && adduser -u 1000 -G node -s /bin/sh -D node \
    && apk del --no-network apk-tools \
    && test -s /lib/apk/db/installed
COPY --from=dependencies /usr/local/bin/node /usr/local/bin/node
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/package.json /app/package-lock.json /app/tsconfig.json ./
COPY --from=dependencies /app/prisma ./prisma

# Explicit source allowlist: no app/routes, tests, seeds, exports, env files,
# gcloud configuration, credentials, or general administration scripts.
COPY scripts/import-legacy-operations.ts scripts/import-legacy-operations-job.ts ./scripts/
COPY lib/operations/legacy-import.ts lib/operations/legacy-import-engine.ts \
     lib/operations/legacy-import-target.ts lib/operations/legacy-import-preflight.ts \
     lib/operations/legacy-import-approval.ts lib/operations/legacy-import-job-policy.ts \
     lib/operations/legacy-import-job-runtime.ts ./lib/operations/
COPY lib/deals/import-csv.ts lib/deals/parse-deal-name.ts ./lib/deals/
COPY lib/data/deal-types.ts lib/data/deal-validate.ts lib/data/client-field-authz.ts ./lib/data/
# The implementation digest includes the exact reviewed dedicated image recipe.
COPY Dockerfile.operations-import Dockerfile.operations-import.dockerignore ./

ENV NODE_ENV=production TSX_DISABLE_CACHE=1
USER node
# Disabled startup rejects before SQL, so separately check the actual musl engine
# can load its TLS/native libraries as the non-root runtime user, without network
# or a database. Retain the package inventory; never hide OS findings from scan.
RUN --network=none node --input-type=commonjs -e '\
    const fs = require("node:fs"); \
    if (process.platform !== "linux" || process.arch !== "x64" || process.getuid() !== 1000) throw new Error("runtime_identity_invalid"); \
    for (const p of ["/usr/local/lib/node_modules/npm", "/usr/local/bin/npm", "/usr/local/bin/npx", "/opt/yarn-v1.22.22", "/usr/local/bin/yarn", "/usr/local/bin/yarnpkg", "/usr/local/include/node", "/usr/bin/gcc", "/usr/bin/g++", "/usr/bin/make", "/usr/bin/python3", "/sbin/apk"]) { if (fs.lstatSync(p, { throwIfNoEntry: false })) throw new Error("build_tool_in_runtime"); } \
    if (!fs.readFileSync("/etc/ssl/certs/ca-certificates.crt", "utf8").includes("BEGIN CERTIFICATE") || !fs.statSync("/lib/apk/db/installed").size) throw new Error("runtime_metadata_missing"); \
    require.resolve("tsx"); \
    const engine = require("./node_modules/.prisma/client/libquery_engine-linux-musl-openssl-3.0.x.so.node"); \
    if (typeof engine.QueryEngine !== "function") throw new Error("prisma_native_engine_missing");'
# Batch completion is the process exit status, bounded by the job's task timeout.
# No HTTP service or superficial Docker HEALTHCHECK is added for this importer.
# No default arguments: absent reviewed target/manifest pins must fail closed.
ENTRYPOINT ["node", "--import", "tsx", "scripts/import-legacy-operations-job.ts"]
CMD []
