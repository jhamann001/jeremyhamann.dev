{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "trade-demo",
  "main": "src/index.js",
  // The app's built static files, copied out of its image by the deploy (.github/workflows/deploy-trade.yml).
  // A request that matches one is answered by Cloudflare directly, without this Worker or the container, so
  // pages load fast and a sleeping container isn't woken for them; anything else reaches the Worker.
  "assets": { "directory": "./static" },
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "trade.jeremyhamann.dev", "custom_domain": true }],
  "vars": {
    "APP_ORIGIN": "https://trade.jeremyhamann.dev"
  },
  // Secrets (set by the deploy workflow): DATABASE_URL, SESSION_SECRET, DEMO_RESET_TOKEN.
  "containers": [
    {
      "class_name": "TradeApp",
      "image": "../Dockerfile",
      "image_build_context": "../../..",
      // One small instance (1/4 vCPU, 1 GiB); it sleeps after 10 idle minutes (see TradeApp.sleepAfter).
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  // The Worker's own version: each deploy's container is started with it, and the deploy check is keyed by it
  // (apps/demo-edge/container-start.js).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "TRADE_APP", "class_name": "TradeApp" }]
  },
  "exports": {
    "TradeApp": { "type": "durable-object", "storage": "sqlite" }
  },
  // Per-visitor ceiling at the edge, before anything reaches the container (counted per Cloudflare location):
  // far above normal use, so it only stops floods, which would otherwise keep the container awake.
  "ratelimits": [{ "name": "VISITOR_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  // The demo's only scheduled job: the nightly reset.
  "triggers": { "crons": ["0 7 * * *"] },
  "observability": { "enabled": true }
}
