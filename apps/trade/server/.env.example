PORT=8080

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# DATABASE_URL is required by node-pg-migrate (npm run db:migrate). When set, the app uses it too, over
# verified TLS unless it says sslmode=disable (as this local example does); without it, the app reads the
# individual DB_* vars below.
DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5432/trade_request?sslmode=disable

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=trade_request
DB_USER=postgres
DB_PASSWORD=changeme

# Cloud SQL Auth Proxy socket (used on Cloud Run / App Engine)
# DB_SOCKET_PATH=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# ─── Google OAuth 2.0 (REQUIRED) ─────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR_DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# ─── Session (REQUIRED) ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-string

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ─── DEV-ONLY auth bypass (DO NOT SET IN PRODUCTION) ─────────────────────────
# When set AND NODE_ENV !== 'production', visiting GET /auth/dev-login
# (and the MCP OAuth authorize endpoint) skips Google entirely and logs in as
# this user. The server refuses to start if this is set with NODE_ENV=production.
# Leave commented out unless you need to bypass Google OAuth locally.
# DEV_LOGIN_EMAIL=you@example.com

# ─── Domain restriction ──────────────────────────────────────────────────────
# Comma-separated list of email domains allowed to sign in or be invited
ALLOWED_EMAIL_DOMAIN=example.com,example.ai

# ─── Warehouse (optional — source of live client & account data) ───────────────
# When all WAREHOUSE_* vars are set, /api/clients fetches from Warehouse.
# When omitted, the app falls back to the local clients/accounts tables
# (populate with: npm run db:seed).
# WAREHOUSE_URL=https://your-org.warehouseapp.com
# WAREHOUSE_API_KEY=your-warehouse-api-key
# WAREHOUSE_CONTACTS_QUESTION_ID=         # crm_contacts (client names + user IDs)
# WAREHOUSE_INVESTMENTS_QUESTION_ID=      # apex_client_investments (user→account mapping + account type)
# WAREHOUSE_BALANCES_QUESTION_ID=         # apex_daily_overnight_balances (account ID → total equity)
# WAREHOUSE_STOCK_RECORD_QUESTION_ID=     # apex_daily_stock_record (position-level holdings per account)

# Cost-basis warehouse source(s) for the drift tax layer.
# WAREHOUSE_COST_BASIS_DB_ID=4            # single source (legacy; default 4 = Prod-redshift)
# WAREHOUSE_COST_BASIS_DB_IDS=4,101       # comma list — read from MULTIPLE replicas and merge.
#   The Apex feed is replicated into more than one Warehouse database and they go
#   stale INDEPENDENTLY. On 2026-08-27 db 4's weekly open-lot loader had been dead
#   since 08-15 (baseline stranded at 08-14, CRITICAL) while db 101
#   (Prod-redshift-replica) held the 08-21 snapshot db 4 never loaded — but db 101's
#   daily deltas stopped a day earlier. Listing both takes the newest weekly
#   baseline from whichever has it and layers every source's daily deltas on top.
#   Unset => single-source behavior, unchanged. Per-source staleness is logged as
#   `cost_basis_source_stale` so a dead loader stays visible after merging.

# ─── Email (optional — omit to disable invite emails) ─────────────────────────
# Any SMTP provider works: Gmail/Google Workspace, SendGrid, Amazon SES, etc.
# For Google Workspace: smtp.gmail.com / port 587 / App Password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Trade Request <noreply@example.com>"

# ─── Slack (optional — omit to disable Slack notifications) ──────────────────
# Create a Slack app at: https://api.slack.com/apps
# Bot needs chat:write scope. Invite the bot to the channel.
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_CHANNEL_ID=C0123456789

# ─── Scheduled jobs (required for daily Slack digest in production) ──────────
# Cloud Scheduler hits POST /api/internal/digest/daily with an OIDC token.
# The app rejects the request unless the token's aud matches SCHEDULER_AUDIENCE
# AND its email claim matches SCHEDULER_SERVICE_ACCOUNT_EMAIL. Leave both unset
# locally; the dev-only GET /api/internal/digest/preview does not require them.
# SCHEDULER_SERVICE_ACCOUNT_EMAIL=trade-request-scheduler@PROJECT_ID.iam.gserviceaccount.com
# SCHEDULER_AUDIENCE=https://trade-request-xxxx-uc.a.run.app

# ── Machine read surface (GET /api/machine/trade-requests) ──────────────────
# OIDC-gated read endpoint for the Ops Portal app's ops-portal-run@ service account. The route
# is INERT (503) until both are set — audience must equal this app's public URL,
# and ALLOWED_MACHINE_SA is a comma-separated allowlist of accepted SA emails.
# Optional tuning: MACHINE_MAX_ROWS (row cap, default 500), RATE_LIMIT_MACHINE_MAX
# (per-window request cap, default 300).
# MACHINE_AUDIENCE=https://trade-request-xxxx-uc.a.run.app
# ALLOWED_MACHINE_SA=ops-portal-run@ops-portal.iam.gserviceaccount.com
# MACHINE_MAX_ROWS=500
# RATE_LIMIT_MACHINE_MAX=300

# ─── Database SSL (set to true for remote/cloud DB connections) ───────────────
# DB_SSL=false
# For production: provide the CA certificate contents.
# WARNING: Do NOT set DB_SSL_REJECT_UNAUTHORIZED=false in production — it
# disables certificate verification and weakens MITM protection.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ─── Session cookie lifetime (default: 1 hour = 3600000ms) ───────────────────
# SESSION_MAX_AGE_MS=3600000

# ─── Database connection pool (default: 10) ──────────────────────────────────
# DB_POOL_MAX=10

# ─── Logging level (trace, debug, info, warn, error, fatal) ──────────────────
# LOG_LEVEL=info

# ─── Registry drift detection (P0) ───────────────────────────────────────────
# Nightly comparison of the in-app Meridian registry against an externally
# uploaded Meridian templates snapshot, with Slack alerting on divergence.
#
# Source contract: `MERIDIAN_SNAPSHOT_SOURCE` selects the backend —
# `gcs` (default) or `s3`. The runner reads the newest
# `<prefix>/<YYYY-MM-DD>.json` from the configured bucket. Snapshots are
# delivered out-of-band (no in-app upload UI is in scope).
#   - gcs: reads gs://${MERIDIAN_SNAPSHOT_BUCKET}/meridian/templates/
#          via Application Default Credentials.
#   - s3:  reads s3://${MERIDIAN_SNAPSHOT_S3_BUCKET}/${MERIDIAN_SNAPSHOT_S3_PREFIX}
#          (prefix defaults to meridian/templates/). Region from
#          MERIDIAN_SNAPSHOT_S3_REGION (or AWS_REGION); credentials from the
#          standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars.
#
# `DRIFT_ENABLED` is the merge-gate / Cloud Scheduler enable flag. Leave it
# `false` until the bucket + snapshot exist in the deploy environment.
# `DRIFT_ALERTS_ENABLED` is the runtime shadow-mode kill switch — when
# `false`, the job runs and persists registry_drift_runs rows but never
# posts to Slack. Flip to `true` after a clean shadow week.
# `DRIFT_SLACK_CHANNEL_ID` is sourced from Secret Manager in production
# (mounted at /secrets/DRIFT_SLACK_CHANNEL_ID). The Slack helper is
# failure-soft: a missing value mutes the alert without breaking the job.
# MERIDIAN_SNAPSHOT_SOURCE=gcs
# MERIDIAN_SNAPSHOT_BUCKET=meridian-templates-prod
# ─ S3 source (set MERIDIAN_SNAPSHOT_SOURCE=s3 to use these instead) ─
# MERIDIAN_SNAPSHOT_S3_BUCKET=meridian-templates-prod
# MERIDIAN_SNAPSHOT_S3_PREFIX=meridian/templates/
# MERIDIAN_SNAPSHOT_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# DRIFT_ENABLED=false
# DRIFT_ALERTS_ENABLED=false
# DRIFT_EXCLUSION_OVERLAP_DIAGNOSTIC_ENABLED=false
# DRIFT_SLACK_CHANNEL_ID=C0123456789

# ─── Ops Portal delegated surface (/api/ops-portal) ───────────────────────────────────────
# Default-off: with either value unset every /api/ops-portal call returns 503.
# OPS_PORTAL_DELEGATED_AUDIENCE is the audience Ops Portal mints for both its ID token and its
# actor assertion; OPS_PORTAL_DELEGATED_CALLER_SA is a comma-separated allowlist of Ops Portal
# runtime service accounts.
# OPS_PORTAL_DELEGATED_AUDIENCE=http://localhost:3001/api/ops-portal
# OPS_PORTAL_DELEGATED_CALLER_SA=ops-portal-local@delegated.invalid
# Local development and tests only: HS256 shared key for both tokens (issuer
# ops-portal-local@delegated.invalid). The server refuses to start with it in production.
# OPS_PORTAL_DELEGATED_LOCAL_KEY=change-me-local-only
# RATE_LIMIT_DELEGATED_MAX=6000

# Service mode (ticket). Emergency override of the persisted mode: active, frozen or mcp-only. Leave unset.
# SERVICE_MODE_OVERRIDE=
# Identity allowed to change the mode through PUT /api/machine/service-mode (default: OPS_PORTAL_DELEGATED_CALLER_SA).
# SERVICE_MODE_CONTROLLER_SA=

# ─── MCP record source (ticket) ────────────────────────────────────────────
# Default-off: with OPS_PORTAL_RECORDS_DB_HOST unset MCP reads this database. When set,
# MCP reads OPS_PORTAL's trade_request schema whenever Ops Portal reports OPS-PORTAL-served.
# OPS_PORTAL_RECORDS_DB_HOST=127.0.0.1
# OPS_PORTAL_RECORDS_DB_PORT=5432
# OPS_PORTAL_RECORDS_DB_NAME=opsPortal
# OPS_PORTAL_RECORDS_DB_USER=trade_request_mcp_ro
# OPS_PORTAL_RECORDS_DB_PASSWORD=
# OPS_PORTAL_RECORDS_DB_SSL=off
# OPS_PORTAL_RECORDS_DB_POOL_MAX=2

# ─── Demo stand-ins (the portfolio demo) ────────────────────────────────────
# DEMO_STAND_INS=on starts stand-ins for the warehouse, the model provider's S3 bucket and Slack's Web
# API on 127.0.0.1:STAND_INS_PORT (loopback only). The settings below point the app's own clients at
# them; email goes to the outbox. `npm run seed:demo` starts them itself to run the reset's jobs.
# The two keys are checked by the stand-ins: set them to random values.
# Locally, keep these in .env.demo rather than .env and use `npm run dev:demo` / `npm run seed:demo:local`:
# a .env is loaded by every process, tests included, and would point the database tests at the demo database.
# DEMO_STAND_INS=on
# STAND_INS_PORT=8090
# PERSONA_SIGN_IN=on                      # sign in as the firm's advisors and traders; Google may then be left unset
# RATE_LIMIT_AUTH_MAX=300                 # every page load calls /auth a few times; the default 30 per 15 minutes is too tight for visitors
# WAREHOUSE_URL=http://127.0.0.1:8090/warehouse
# WAREHOUSE_API_KEY=<random>
# WAREHOUSE_CONTACTS_QUESTION_ID=contacts
# WAREHOUSE_INVESTMENTS_QUESTION_ID=investments
# WAREHOUSE_BALANCES_QUESTION_ID=balances
# WAREHOUSE_STOCK_RECORD_QUESTION_ID=stock-record
# MERIDIAN_SNAPSHOT_SOURCE=s3
# MERIDIAN_SNAPSHOT_S3_BUCKET=meridian-feeds
# MERIDIAN_SNAPSHOT_S3_PREFIX=Accounts-and-associations/
# MERIDIAN_SNAPSHOT_S3_ENDPOINT=http://127.0.0.1:8090/s3
# MERIDIAN_SNAPSHOT_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=stand-in
# AWS_SECRET_ACCESS_KEY=stand-in
# SLACK_API_URL=http://127.0.0.1:8090/slack/api/
# SLACK_BOT_TOKEN=<random>
# SLACK_CHANNEL_ID=C0DEMOTRADES
# DRIFT_SLACK_CHANNEL_ID=C0DEMODRIFT
# DRIFT_ALERTS_ENABLED=true
# EMAIL_TRANSPORT=outbox
