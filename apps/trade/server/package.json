{
  "name": "@trade-request/server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node-pg-migrate up --migrations-dir migrations",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations",
    "seed": "tsx src/db/seed-runner.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx src/db/seedFromUniverse.ts",
    "dev:demo": "tsx watch --env-file=.env.demo src/index.ts",
    "seed:demo:local": "tsx --env-file=.env.demo src/db/seedFromUniverse.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1108.0",
    "@google-cloud/storage": "8.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@slack/web-api": "7.19.0",
    "@trade-request/shared": "*",
    "compression": "1.8.2",
    "connect-pg-simple": "10.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "jose": "6.2.8",
    "node-pg-migrate": "8.0.4",
    "nodemailer": "10.1.4",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "yahoo-finance2": "4.0.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/connect-pg-simple": "7.0.3",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-rate-limit": "5.1.3",
    "@types/express-session": "1.19.0",
    "@types/nodemailer": "8.0.1",
    "@types/passport": "1.0.17",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/pg": "8.21.0",
    "@types/supertest": "7.2.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "4.1.12",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
