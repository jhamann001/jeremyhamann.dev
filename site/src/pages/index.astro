---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Preview from '../components/Preview.astro';
import { projects } from '../data/projects';
import { ABOUT, JOBS, LINKS, PRIVATE_WORK, PROOF, SKILLS } from '../data/profile';

// The lead project gets the full-width card, with the apps that run inside it feeding in; the rest follow.
const lead = projects.find((p) => p.lead);
const feeders = projects.filter((p) => p.inside);
const others = projects.filter((p) => !p.lead);
const leadName = (slug?: string) => projects.find((p) => p.slug === slug)?.name;

const TOOLS = ['Claude Code', 'Cursor', 'Codex', 'Gemini', 'MCP servers', 'n8n'];
const STEPS: [string, string, string][] = [
  ['users', 'Start with the work I do every day', 'I still do the ops and trading work myself, so I know where the time goes.'],
  ['square-terminal', 'Build prompt-first', 'AI agents draft the code. I steer them and test what comes back, keeping the scope tight.'],
  ['eye', 'I review every change', 'Nothing reaches production until I’ve read it and it has passed an approval gate.'],
  ['git-merge', 'Live with it in production', 'I own what I ship and keep improving it with the team that uses it.'],
];
---
<Base
  title="Jeremy Hamann · Ops and trading background, building AI-first fintech software"
  description="Jeremy Hamann does brokerage operations and trading work every day and builds the software it runs on. An AI-first builder with a Series 65, he makes tools for wealth-management operations and is open to advisor, engineering, product and ops automation roles in fintech and wealthtech."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Open to new roles<span aria-hidden="true">·</span>Raleigh, NC<span aria-hidden="true">·</span>Remote-friendly</p>
      <h1>I do the ops work. <span class="h1-soft">I also build the software it runs on.</span></h1>
      <p class="sub">I’m <strong>Jeremy Hamann</strong>. I’ve spent about three years in wealth management on trading desks and in brokerage operations, and I still do that ops and trading work every day. For the past year I’ve also been the main builder of the internal tools my team runs on. I build AI-first and hold an active Series 65. I know the users because I’m one of them.</p>
      <div class="focus">
        <p><span>What I do:</span> <strong>Building tools for wealth-management operations</strong></p>
        <p class="focus-note">I’m open to engineering, product and ops automation roles in fintech and wealthtech.</p>
      </div>
      <div class="btns">
        <a class="btn btn-primary" href="#work">View projects <Icon name="arrow-right" /></a>
        <a class="btn" href={LINKS.resume} download><Icon name="download" /> Download résumé</a>
        <a class="btn" href={LINKS.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={15} /> LinkedIn</a>
        <a class="btn" href={LINKS.github} target="_blank" rel="noopener"><Icon name="github" /> GitHub</a>
      </div>
    </div>
    <div class="container">
      <dl class="proof">
        {PROOF.map((p) => (
          <div>
            <dt>{p.value}{p.unit && <small> {p.unit}</small>}</dt>
            <dd><b>{p.label}</b>{p.sub}</dd>
          </div>
        ))}
      </dl>
      <p class="proof-note"><Icon name="lock" size={13} /> {PRIVATE_WORK.note} <a href="#work">{PRIVATE_WORK.link}</a></p>
    </div>
  </section>

  <section class="section" id="work">
    <div class="container">
      <div class="sec-head">
        <div><h2>Selected projects</h2><p>I’ve rebuilt five production systems as public demos. Each has a case study and, when it ships, a live demo.</p></div>
        <span class="sec-note"><Icon name="lock" size={14} /> All demo data is synthetic and resets nightly</span>
      </div>
      {lead && (
        <article class="proj proj-lead" style={`--c:${lead.color}`}>
          <Preview project={lead} href={`/projects/${lead.slug}`} />
          <div class="proj-body">
            <div class="proj-title">
              <span class="app-dot"><Icon name={lead.icon} size={13} /></span>
              <h3><a href={`/projects/${lead.slug}`}>{lead.name}</a></h3>
              {lead.status === 'live' ? <span class="badge-live">Live</span> : <span class="badge-soon">Demo coming soon</span>}
            </div>
            <p>{lead.card}</p>
            <div class="feeds" role="img" aria-label={`${feeders.map((f) => f.name).join(', ')} run inside ${lead.name}`}>
              <ul>
                {feeders.map((f) => <li style={`--c:${f.color}`}><span class="app-dot"><Icon name={f.icon} size={11} /></span>{f.name}</li>)}
              </ul>
              <span class="feeds-arrow" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
              <div class="feeds-hub"><span class="app-dot"><Icon name={lead.icon} size={11} /></span>{lead.name}</div>
            </div>
            {lead.production && <p class="in-prod"><b>In production:</b> {lead.production}</p>}
            <div class="stack">{lead.stack.join(' · ')}</div>
            <div class="proj-links">
              <a class="link" href={`/projects/${lead.slug}`}>Case study <Icon name="arrow-right" size={15} /></a>
              {lead.status === 'live'
                ? <a class="link" data-demo href={`https://${lead.host}.jeremyhamann.dev`}>Live demo <Icon name="arrow-up-right" size={15} /></a>
                : <span class="link muted">Live demo soon</span>}
            </div>
          </div>
        </article>
      )}
      <div class="projects">
        {others.map((p) => (
          <article class="proj" style={`--c:${p.color}`}>
            <Preview project={p} href={`/projects/${p.slug}`} />
            <div class="proj-body">
              <div class="proj-title">
                <span class="app-dot"><Icon name={p.icon} size={13} /></span>
                <h3><a href={`/projects/${p.slug}`}>{p.name}</a></h3>
                {p.status === 'live' ? <span class="badge-live">Live</span> : <span class="badge-soon">Demo coming soon</span>}
              </div>
              <p>{p.card}</p>
              {p.production && <p class="in-prod"><b>In production:</b> {p.production}</p>}
              {p.inside && <p class="inside"><Icon name="corner-down-right" size={14} /> Also ships inside <a href={`/projects/${p.inside}`}>{leadName(p.inside)}</a></p>}
              <div class="stack">{p.stack.join(' · ')}</div>
              <div class="proj-links">
                <a class="link" href={`/projects/${p.slug}`}>Case study <Icon name="arrow-right" size={15} /></a>
                {p.status === 'live'
                  ? <a class="link" data-demo href={`https://${p.host}.jeremyhamann.dev`}>Live demo <Icon name="arrow-up-right" size={15} /></a>
                  : <span class="link muted">Live demo soon</span>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="how-i-build">
    <div class="container">
      <div class="sec-head"><div><h2>How I build</h2><p>I build prompt-first every day. It’s fast, but nothing ships that I haven’t read.</p></div></div>
      <div class="build">
        <div class="build-main">
          <p>Because I’m also in the ops and trading work every day, I see firsthand what’s actually broken and decide what gets built first. Then I work prompt-first with AI agents in Claude Code and Cursor to ship it.</p>
          <p>The speed is real, but I still read and review everything before it goes out. That’s how one person merged 1,600+ PRs across 5 production apps in about a year without skipping the boring parts, like separate environments, CI checks, security scanning and an approval gate on every production deploy.</p>
          <ul class="tools" aria-label="Tools">{TOOLS.map((t) => <li>{t}</li>)}</ul>
        </div>
        <ol class="build-steps">
          {STEPS.map(([icon, title, text]) => (
            <li><span class="pi"><Icon name={icon} /></span><div><h3>{title}</h3><p>{text}</p></div></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section" id="principles">
    <div class="container">
      <div class="sec-head"><div><h2>How I work</h2></div></div>
      <div class="principles">
        <div class="principle"><span class="pi"><Icon name="scroll-text" /></span><h3>Audit trail by default</h3><p>Every write is attributable and reviewable, so when a regulator asks what happened, the answer comes from a query.</p></div>
        <div class="principle"><span class="pi"><Icon name="git-compare" /></span><h3>Models assist, rules decide</h3><p>AI does the reading and drafting, but anything that moves money or changes a record goes through deterministic, tested logic.</p></div>
        <div class="principle"><span class="pi"><Icon name="shield-check" /></span><h3>Small, reversible releases</h3><p>I ship behind feature flags, with separate environments and an explicit approval before anything reaches production.</p></div>
        <div class="principle"><span class="pi"><Icon name="lock-keyhole" /></span><h3>Encrypted in transit and at rest</h3><p>All five apps serve HTTPS, reach their databases over encrypted connections and keep data encrypted at rest. Their secrets live in a secrets manager, never in the code.</p></div>
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <div class="sec-head"><div><h2>Experience</h2><p>My background is in trading desks and brokerage ops. I still do the ops work today, and I build the tools for it.</p></div></div>
      <div class="xp">
        {JOBS.map((job) => (
          <div class="xp-row">
            <div class="xp-when"><b>{job.company}</b><span>{job.place}</span><span class="mono">{job.dates}</span></div>
            <div class="xp-roles">
              {job.roles.map((r) => (
                <div class="xp-role">
                  <div class="xp-title"><h3>{r.title}</h3>{r.dates && <span class="mono">{r.dates}</span>}</div>
                  {r.badge && <span class="badge-note">{r.badge}</span>}
                  {r.org && <p class="org">{r.org}</p>}
                  <ul>{r.bullets.map((b) => <li>{Array.isArray(b) ? <Fragment><b>{b[0]}:</b> {b[1]}</Fragment> : b}</li>)}</ul>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div class="creds">
        <div class="cred">
          <span class="pi"><Icon name="circle-check" /></span>
          <div><h3>Series 65</h3><p>Uniform Investment Adviser Law Examination</p></div>
          <span class="badge-live">Active</span>
        </div>
        <div class="cred">
          <span class="pi"><Icon name="graduation-cap" /></span>
          <div><h3>BBA in Finance</h3><p>Bob Jones University</p></div>
          <span class="mono cred-when">2019 – 2023</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <div class="sec-head"><div><h2>About</h2></div></div>
      <div class="about">
        <div class="prose">
          {ABOUT.map((p) => <p>{p}</p>)}
          <p><strong>What’s next:</strong> I’d love to stay in fintech or wealthtech, in product, engineering, ops automation or an associate advisor role (my Series 65 helps there), but I’m open to the right role outside it too.</p>
        </div>
        <dl class="skills">
          {SKILLS.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container">
      <div class="contact">
        <div>
          <h2>Let’s talk</h2>
          <p>I build tools for wealth-management operations, and I still do the ops and trading work they’re built for. I’m looking for my next advisor, engineering, product or ops automation role in fintech or wealthtech. I’m also happy to compare notes on ops engineering and internal tools.</p>
          <p class="contact-note">My code is mostly in private company repos, so the <a href="#work">projects above</a> are the best place to see it.</p>
          <p class="addr">{LINKS.email}</p>
          <ul class="facts">
            <li><Icon name="map-pin" size={15} /> Raleigh, NC · open to remote</li>
            <li><Icon name="circle-check" size={15} /> Series 65, active</li>
          </ul>
        </div>
        <div class="contact-btns">
          <button class="btn btn-primary" type="button" id="copy-email" data-email={LINKS.email}><Icon name="mail" /> <span>Copy email</span></button>
          <a class="btn" href={LINKS.resume} download><Icon name="download" /> Résumé (PDF)</a>
          <a class="btn" href={LINKS.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={15} /> LinkedIn</a>
          <a class="btn" href={LINKS.github} target="_blank" rel="noopener"><Icon name="github" /> GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Base>
<script>
  const b = document.getElementById('copy-email') as HTMLButtonElement | null;
  b?.addEventListener('click', async () => {
    const label = b.querySelector('span');
    try {
      await navigator.clipboard.writeText(b.dataset.email ?? '');
      if (label) label.textContent = 'Copied';
    } catch {
      if (label) label.textContent = 'Select the address to copy';
    }
    setTimeout(() => { if (label) label.textContent = 'Copy email'; }, 2400);
  });
</script>
